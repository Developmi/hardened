# ==============================================================================
# Plane - Environment Configuration Example (Developmi Platform)
# ==============================================================================

# Network settings
SHARED_NETWORK_NAME=public_net
PLANE_PORT=8090

# Pin images (v1.4.2 stable release)
PLANE_BACKEND_IMAGE=makeplane/plane-backend:v1.4.2
PLANE_FRONTEND_IMAGE=makeplane/plane-frontend:v1.4.2
PLANE_SPACE_IMAGE=makeplane/plane-space:v1.4.2
PLANE_ADMIN_IMAGE=makeplane/plane-admin:v1.4.2
PLANE_LIVE_IMAGE=makeplane/plane-live:v1.4.2
PLANE_PROXY_IMAGE=makeplane/plane-proxy:v1.4.2
PLANE_DB_IMAGE=postgres:15.7-alpine
PLANE_REDIS_IMAGE=valkey/valkey:7.2.11-alpine
PLANE_MQ_IMAGE=rabbitmq:3.13.6-management-alpine
PLANE_MINIO_IMAGE=docker.io/pgsty/silo:RELEASE.2026-09-16T00-00-00Z

# Domain & Web URL (initially localhost:8090 until Caddy domain is attached)
APP_DOMAIN=localhost:8090
WEB_URL=http://localhost:8090
CORS_ALLOWED_ORIGINS=http://localhost:8090
SITE_ADDRESS=:80
DEBUG=0

# Database Credentials
POSTGRES_USER=plane
POSTGRES_DB=plane
POSTGRES_PASSWORD=changeme_postgres_password

# RabbitMQ Credentials
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=changeme_rabbitmq_password
RABBITMQ_VHOST=plane

# MinIO / S3 Storage Credentials
AWS_ACCESS_KEY_ID=plane-minio-key
AWS_SECRET_ACCESS_KEY=changeme_minio_secret_key
AWS_S3_BUCKET_NAME=uploads

# Security Keys (Generate via: python3 -c 'import secrets; print(secrets.token_urlsafe(32))')
SECRET_KEY=changeme_django_secret_key
LIVE_SERVER_SECRET_KEY=changeme_live_server_secret_key

# Webhooks (Optional restrictions)
WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=
