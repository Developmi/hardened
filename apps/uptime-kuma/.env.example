# Environment variables - user-managed
# This stack does NOT deploy applications.
# The operator is responsible for providing their own environment configuration.
# Copy to .env and fill in real values. There are no secrets here: the admin
# account and its password are created through the web UI on first boot.

# Images (exact pins, registry-verified 2026-10-14 - override with an exact tag only)
UPTIME_KUMA_IMAGE=louislam/uptime-kuma:2.5.6

# Application
UPTIME_KUMA_PORT=3001
UPTIME_KUMA_HOST=0.0.0.0
UPTIME_KUMA_DB_TYPE=sqlite
UPTIME_KUMA_RATELIMIT=true
UPTIME_KUMA_WS_MESSAGE_COMPRESSION=false
UPTIME_KUMA_DISABLE_FRAME_SAMEORIGIN=false
UPTIME_KUMA_DISABLE_LOGO=false
UPTIME_KUMA_DISABLE_AUTH=false
