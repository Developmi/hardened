# Environment variables - user-managed
# This stack does NOT deploy applications.
# The operator is responsible for providing their own environment configuration.
# Copy to .env and fill in real values; secrets below are placeholders (changeme).

# Images (exact pins, registry-verified 2026-10-14 - override with an exact tag only)
OPENLIT_IMAGE=ghcr.io/openlit/openlit:2.1.0
OPENLIT_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.9.19.9-alpine

# Embedded ClickHouse (shared credentials: this single secret keeps the
# clickhouse service auth and OpenLIT's INIT_DB_* auth in sync)
OPENLIT_DB_HOST=clickhouse
OPENLIT_DB_PORT=8123
OPENLIT_DB_NAME=openlit
OPENLIT_DB_USER=default
OPENLIT_DB_PASSWORD=changeme

# Application
OPENLIT_PORT=3000
OPENLIT_EDITION=oss

# OAuth (optional - leave empty to disable the provider)
OPENLIT_GOOGLE_CLIENT_ID=
OPENLIT_GOOGLE_CLIENT_SECRET=
OPENLIT_GITHUB_CLIENT_ID=
OPENLIT_GITHUB_CLIENT_SECRET=

# OpAMP server
OPENLIT_OPAMP_ENVIRONMENT=production
OPENLIT_OPAMP_TLS_INSECURE_SKIP_VERIFY=false
OPENLIT_OPAMP_TLS_REQUIRE_CLIENT_CERT=true
OPENLIT_OPAMP_TLS_MIN_VERSION=1.2
OPENLIT_OPAMP_TLS_MAX_VERSION=1.3
OPENLIT_OPAMP_LOG_LEVEL=info
