# Environment variables - user-managed
# This stack does NOT deploy applications.
# The operator is responsible for providing their own environment configuration.
# Copy to .env and fill in real values; secrets below are placeholders (changeme).

# Images (exact pins, registry-verified 2026-10-14 - override with an exact tag only)
CHATWOOT_IMAGE=chatwoot/chatwoot:v4.18.0
CHATWOOT_DB_IMAGE=pgvector/pgvector:0.8.6-pg17
CHATWOOT_VALKEY_IMAGE=valkey/valkey:9.1.1

# App
CHATWOOT_FRONTEND_URL=https://chat.example.com
CHATWOOT_SECRET_KEY_BASE=changeme
CHATWOOT_DB_USER=chatwoot
CHATWOOT_DB_PASSWORD=changeme
CHATWOOT_DB_PORT=5432

# Valkey (cache/queue)
CHATWOOT_REDIS_PASSWORD=changeme

# SMTP
CHATWOOT_MAILER_SENDER_EMAIL=chatwoot@example.com
CHATWOOT_SMTP_ADDRESS=smtp.example.com
CHATWOOT_SMTP_USERNAME=changeme
CHATWOOT_SMTP_PASSWORD=changeme
