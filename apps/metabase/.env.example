# Environment variables - user-managed
# This stack does NOT deploy applications.
# The operator is responsible for providing their own environment configuration.
# Copy to .env and fill in real values; secrets below are placeholders (changeme).

# Images (exact pins, registry-verified 2026-10-14 - override with an exact tag only)
METABASE_IMAGE=metabase/metabase:v0.64.1
METABASE_DB_IMAGE=postgres:17.11-alpine

# Database
METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=changeme
METABASE_DB_HOST=metabase-db
METABASE_DB_PORT=5432

# App
METABASE_SITE_NAME=Metabase
METABASE_SITE_URL=https://metabase.example.com
METABASE_JAVA_TIMEZONE=UTC
METABASE_QUERY_CACHING_MAX_KB=10000
METABASE_QUERY_CACHING_MAX_TTL=60
