# Environment variables - user-managed
# This stack does NOT deploy applications.
# The operator is responsible for providing their own environment configuration.
# Copy to .env and fill in real values; secrets below are placeholders (changeme).

# Images (exact pins, registry-verified 2026-10-14 - override with an exact tag only)
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.12.1
OPENWEBUI_DB_IMAGE=postgres:17.11-alpine
OPENWEBUI_VALKEY_IMAGE=valkey/valkey:9.1.1

# App
OPENWEBUI_ENV=prod
OPENWEBUI_NAME=OpenWebUI
OPENWEBUI_URL=http://localhost:8080
OPENWEBUI_AUTH=true
OPENWEBUI_ENABLE_SIGNUP=false
OPENWEBUI_ENABLE_LOGIN=true
OPENWEBUI_SECRET_KEY=changeme
OPENWEBUI_ANONYMIZED_TELEMETRY=false
OPENWEBUI_ENABLE_FORWARD_USER_INFO_HEADERS=true
OPENWEBUI_ENABLE_FOLLOW_UP_GENERATION=false
OPENWEBUI_ENABLE_TITLE_GENERATION=true

# Database (URL form: postgresql://user:pass@host:port/dbname - percent-encode # pragma: allowlist secret
# URL-reserved characters in the password, e.g. @ -> %40)
OPENWEBUI_DB_HOST=postgres
OPENWEBUI_DB_PORT=5432
OPENWEBUI_DB_NAME=openwebui
OPENWEBUI_DB_USER=openwebui
OPENWEBUI_DB_PASSWORD=changeme

# Valkey (cache)
OPENWEBUI_REDIS_HOST=valkey
OPENWEBUI_REDIS_PORT=6379
OPENWEBUI_REDIS_PASSWORD=changeme
