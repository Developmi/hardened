# Environment variables - user-managed
# This stack does NOT deploy applications.
# The operator is responsible for providing their own environment configuration.
# Copy to .env and fill in real values; secrets below are placeholders (changeme).

# Images (exact pins, registry-verified 2026-10-14 - override with an exact tag only)
NOCDB_IMAGE=nocodb/nocodb:2026.09.1
NOCDB_DB_IMAGE=postgres:17.11-alpine

# App
NOCDB_PUBLIC_URL=https://example.com
NOCDB_DISABLE_TELEMETRY=true

# Database (NocoDB metadata lives on PostgreSQL; NC_DB URL form:
# pg://host:port?u=user&p=pass&d=dbname - percent-encode URL-reserved
# characters in the password, e.g. @ -> %40, & -> %26)
NOCDB_DB_HOST=postgres
NOCDB_DB_PORT=5432
NOCDB_DB_NAME=nocodb
NOCDB_DB_USER=nocodb
NOCDB_DB_PASSWORD=changeme
