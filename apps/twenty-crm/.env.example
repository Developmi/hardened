# Environment variables - user-managed
# This stack does NOT deploy applications.
# The operator is responsible for providing their own environment configuration.
# Copy to .env and fill in real values; secrets below are placeholders (changeme).

# Images (exact pins, registry-verified 2026-10-14 - override with an exact tag only)
TWENTY_IMAGE=twentycrm/twenty:v2.46.0
TWENTY_DB_IMAGE=postgres:17.11-alpine
TWENTY_VALKEY_IMAGE=valkey/valkey:9.1.1

# App
TWENTY_SERVER_URL=https://example.com
TWENTY_APP_SECRET=changeme
# Required from the FIRST v2.26.0 boot (v2.5+ at-rest encryption envelope).
# Generate once: openssl rand -hex 32 - keep stable forever; rotating the key
# after boot makes already-encrypted data undecryptable.
TWENTY_ENCRYPTION_KEY=changeme

# Database (database name is fixed as "twenty" in compose)
TWENTY_DB_USER=twenty
TWENTY_DB_PASSWORD=changeme

# Valkey (queue broker)
TWENTY_REDIS_PASSWORD=changeme
