# Environment variables - user-managed
# This stack does NOT deploy applications.
# The operator is responsible for providing their own environment configuration.
# Copy to .env and fill in real values; secrets below are placeholders (changeme).

# Images (exact pins, registry-verified 2026-10-14 - override with an exact tag only)
N8N_IMAGE=n8nio/n8n:2.43.5
N8N_RUNNER_IMAGE=n8nio/runners:2.43.5
N8N_DB_IMAGE=postgres:17.11-alpine
N8N_VALKEY_IMAGE=valkey/valkey:9.1.1

# App
N8N_HOST=example.com
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://example.com
N8N_WEBHOOK_URL=https://example.com
N8N_PROXY_HOPS=1
N8N_EXECUTIONS_MODE=queue
N8N_OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
N8N_LOG_LEVEL=warn
N8N_LOG_OUTPUT=json
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

# Database
N8N_DB_TYPE=postgresdb
N8N_DB_POSTGRESDB_HOST=postgres
N8N_DB_POSTGRESDB_PORT=5432
N8N_DB_POSTGRESDB_DATABASE=n8n
N8N_DB_POSTGRESDB_USER=n8n
N8N_DB_POSTGRESDB_PASSWORD=changeme

# Valkey (queue broker)
N8N_REDIS_HOST=valkey
N8N_REDIS_PORT=6379
N8N_REDIS_PASSWORD=changeme

# Authentication
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
N8N_ENCRYPTION_KEY=changeme

# Runners
N8N_RUNNERS_AUTH_TOKEN=changeme
N8N_RUNNERS_AUTO_SHUTDOWN_TIMEOUT=15
