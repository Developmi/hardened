# Caddyfile.example - L4_networking/caddy role (Single Source of Truth)
# Rendered from SOPS (secrets.sops.yml), filtered per-node via target_group ∩ group_names.
#
# VARIABLE OWNERSHIP (three layers - NEVER mix):
#   Layer 1 | SOPS (secrets.sops.yml)      → domains, certs, routes, API keys
#   Layer 2 | inventory (hosts.ini)       → caddy_node_id, waf_mode_default (per host)
#   Layer 3 | group_vars (brain|muscle)   → caddy_type, caddy_admin_enabled (group defaults)
#
# L4-NETWORKING / EDGE (SDD l4-networking-edge):
#   Per-client cert path: /etc/caddy/certs/<client>/fullchain.pem
#   ADR-04 - Hot-reload via docker exec caddy reload (no connection drops)
#   ADR-05 - Per-service WAF mode via waf_mode (enforcement | detection_only)
#   SC-28  | All domains and upstreams live exclusively in the encrypted SOPS file.
#   SC-7   | Per-service security headers in site blocks.
#   SC-8   | TLS 1.2/1.3 enforced; HTTP→HTTPS redirect; Cloudflare Origin Pull supported.
#   AU-12  | D6 log pipeline: access + runtime + Coraza audit logs as FILES in
#           | /data/logs (single writer per stream, native rotation).
#           | Consumers: CrowdSec (access.log) + promtail → Loki (all three).
#           | SI-4   | OWASP CRS via Coraza WAF; per-service enforcement mode (waf_mode).
    #   AC-3   | Admin API off by default; when the caddy-waf-ui is deployed it must
    #           | be enabled with origins allow-list + container-network binding (M1, §6).
#
# ROUTING: for-loop iterates ingress_services, skipping entries whose target_group
# does not intersect with the current node's group_names OR match caddy_node_id.
# target_group examples: "muscle" | "brain" | "muscle-1" | ["muscle-1", "brain-1"]
#
# UI-MANAGED SITES (caddy-waf-ui contract, D2):
#   svc.ui_managed: true  → per-slug overlay imports (ip-rules first, then waf),
#                           NEVER import waf nor route /waf* (double coraza_waf breaks reload).
#   svc.ui_managed: false → current behavior (import waf + route /waf* per waf_mode).
#   Slug = DomainSlug contract: lowercase; '.'→'_'; '*'→'wildcard'; '?'→'qmark'; '-'→'_'.
#   The role pre-creates placeholders /etc/caddy/ui-managed/{ip-rules,waf,exclusions}-{slug}.conf
#   (waf placeholder = baseline DetectionOnly, NEVER empty; missing file = Caddy hard-fail).
#   After the first UI write the files are UI-owned — the role never overwrites them.
#
# WAF MODE (ADR-05):
#   waf_mode_default - fallback for services without explicit waf_mode
#   svc.waf_mode     - per-service override (enforcement | detection_only)
#
# WEBSOCKET: when proxy_headers.websocket=true, a @ws matcher bypasses Coraza
# (Coraza doesn't support WS upgrades). All other HTTP goes through WAF.
{
    {% if caddy_admin_enabled | default(false) %}
    # M1 (caddy-waf-ui contract) | Admin API on the container network only:
    #   - binds 0.0.0.0:2019 INSIDE the container so the UI (caddy-waf:2019)
    #     and VictoriaMetrics scraping can reach it over the internal network;
    #   - NEVER published to the host (compose publishes only 80/443);
    #   - origins allow-list permits headerless machine clients (the UI's Go HTTP
    #     client sends no Origin/Referer headers) while rejecting cross-origin
    #     browser requests; enforce_origin is intentionally NOT used because
    #     Caddy v2.11.4 rejects headerless requests under enforce_origin, which
    #     would break UI hot-reload (POST /load always 403s);
    #   - the Host/DNS-rebinding check is DISABLED on the wildcard 0.0.0.0:2019
    #     binding (Caddy enforceHost = !isWildcardInterface()); residual browser
    #     protection comes from Sec-Fetch-Mode triggering the origin check;
    #   - mTLS (identity + client certs) is the contract §6 target state.
    admin 0.0.0.0:2019 {
        origins http://caddy-waf:2019 http://localhost:2019
    }
    {% else %}
    # AC-3 | Admin API disabled in production (default; no UI deployed)
    admin off
    {% endif %}
    email {{ caddy_acme_email | default('') }}
    order coraza_waf first
    order rate_limit before basicauth

    # AU-12 (D6) | Runtime/global log → FILE (Caddy internal events, NOT access logs).
    # Contract §7: single writer per stream; promtail scrapes /data/logs/caddy.log.
    # Native rotation: roll at 30MiB, keep 5 files, max 720h (30 days) per file.
    log {
        output file /data/logs/caddy.log {
            roll_size 30MiB
            roll_keep 5
            roll_keep_for 720h
        }
        format json
    }

    # Cloudflare real IP restoration (trusted_proxies)
    servers {
        trusted_proxies static {
            173.245.48.0/20
            103.21.244.0/22
            103.22.200.0/22
            103.31.4.0/22
            141.101.64.0/18
            108.162.192.0/18
            190.93.240.0/20
            188.114.96.0/20
            197.234.240.0/22
            198.41.128.0/17
            162.158.0.0/15
            104.16.0.0/13
            104.24.0.0/14
            172.64.0.0/13
            131.0.72.0/22
        }
    }
}

# SC-8 | HTTP → HTTPS redirect
# D6: no access log here — redirects are logged at the target :443 site (avoids
# duplicate lines for the same request in CrowdSec/promtail).
:80 {
    redir https://{host}{uri} permanent
}

# Health check (Docker) — no access log (probe noise)
:2020 {
    respond "OK" 200
}

# ── WAF snippets (Coraza + OWASP CRS) ──────────────────────────────────
# Global service protection with Coraza WAF & OWASP CRS.
# Config and CRS rules baked into caddy-waf image at /etc/caddy/.
(waf_enforcement) {
    coraza_waf {
        directives `
            Include /etc/caddy/coraza.conf
            Include /etc/caddy/owasp-crs/crs-setup.conf
            Include /etc/caddy/owasp-crs/rules/*.conf
            SecRuleEngine On
            SecAuditEngine RelevantOnly
            SecAuditLog /data/logs/coraza-audit.log
            SecAuditLogFormat JSON
            SecAuditLogParts ABCDEFGHIJKZ
        `
    }
}

(waf_detection) {
    coraza_waf {
        directives `
            Include /etc/caddy/coraza.conf
            Include /etc/caddy/owasp-crs/crs-setup.conf
            Include /etc/caddy/owasp-crs/rules/*.conf
            SecRuleEngine DetectionOnly
            SecAuditEngine RelevantOnly
            SecAuditLog /data/logs/coraza-audit.log
            SecAuditLogFormat JSON
            SecAuditLogParts ABCDEFGHIJKZ
        `
    }
}

(waf) {
    coraza_waf {
        directives `
            Include /etc/caddy/coraza.conf
            Include /etc/caddy/owasp-crs/crs-setup.conf
            Include /etc/caddy/owasp-crs/rules/*.conf
            SecRuleEngine DetectionOnly
            SecAuditEngine RelevantOnly
            SecAuditLog /data/logs/coraza-audit.log
            SecAuditLogFormat JSON
            SecAuditLogParts ABCDEFGHIJKZ
        `
    }
}

# ── Reusable Security Headers Snippet ─────────────────────────────────
(security_headers) {
    header {
        # Information disclosure suppression
        -Server
        -X-Powered-By
        -X-AspNet-Version

        # HTTP Security Headers
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        X-Permitted-Cross-Domain-Policies "none"

        # Content Security Policy (OWASP secure baseline - adapt for application-specific assets)
        Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self';"
    }
}

# ── Reusable Rate Limiting Snippet (caddy-ratelimit) ───────────────────
(rate_limiting) {
    rate_limit {
        zone default {
            key {remote_host}
            events 100
            window 1m
        }
    }
}

# ── Perimeter Hardening (Sensitive Paths) ─────────────────────────────
(perimeter_hardening) {
    @sensitive_paths {
        path /.git* /.env* /.aws* /.docker* *.sql *.htpasswd *.bak *.conf
    }
    respond @sensitive_paths "Forbidden" 403
}

# ── Zero Trust VPN restriction ────────────────────────────────────────
(vpn_only) {
    @denied_vpn {
        not remote_ip {{ tailscale_subnet }} 127.0.0.1/8 ::1
    }
    abort @denied_vpn
}

# ── Dynamic application routes (client-scoped cert paths) ─────
#
# Example ingress_services entry in group_vars/all/secrets.sops.yml (SOPS):
#
#   - name: my-app
#     domain: app.example.com
#     upstream: my-app-container:8080
#     target_group: muscle
#     security_profile: public_waf
#     client: "client_example"           # required: drives cert path + routing (see secrets.yml.example)
#     tls_client_auth: cloudflare        # optional, enables Origin Pull
#     waf_mode: enforcement              # optional, overrides waf_mode_default
#     proxy_headers:
#       standard: false                  # forward Host + X-Real-IP to backend
#       websocket: false                 # bypass Coraza for WS upgrades
#     x_frame_options: DENY
#     referrer_policy: strict-origin-when-cross-origin
#     csp: "default-src 'self'; script-src 'self' 'unsafe-inline'..."
#     permissions_policy: "camera=(), microphone=(), geolocation=()"
#
{% for svc in ingress_services %}
{% if svc.target_group is defined %}
{% set _tg = [svc.target_group] if svc.target_group is string else svc.target_group %}
{% if _tg | select('in', group_names) | list | length > 0 or caddy_node_id in _tg %}
{% set ph = svc.proxy_headers | default({}) %}
{% set _waf_mode = svc.waf_mode | default(waf_mode_default) %}
{% set _ui_managed = svc.ui_managed | default(false) %}
{% set _slug = svc.domain | lower | replace('.', '_') | replace('*', 'wildcard') | replace('?', 'qmark') | replace('-', '_') %}
{{ svc.domain }} {
    {% set _profile = ingress_security_profiles[svc.security_profile] %}
    {% if _profile.import_vpn_only | default(false) %}
    import vpn_only
    {% endif %}

    # AU-12 (D6) | Access log → FILE, shared single writer across sites.
    # Contract §7: consumers = CrowdSec acquisition (type: caddy) + promtail → Loki.
    log {
        output file /data/logs/access.log {
            roll_size 30MiB
            roll_keep 5
            roll_keep_for 720h
        }
        format json
    }

    import perimeter_hardening

    {% if _profile.rate_limit | default(100) > 0 %}
    import rate_limiting
    {% endif %}

    {% if _ui_managed %}
    # D2 | UI-managed site: per-slug overlay imports (order: ip-rules first —
    # blocked traffic never reaches Coraza). Files owned by caddy-waf-ui after first write.
    import /etc/caddy/ui-managed/ip-rules-{{ _slug }}.conf
    import /etc/caddy/ui-managed/waf-{{ _slug }}.conf
    {% endif %}

    {% if ph.websocket | default(false) %}
    # WebSocket bypass - Coraza doesn't support WS upgrades
    @ws {
        header Connection *Upgrade*
        header Upgrade    websocket
    }
    handle @ws {
        reverse_proxy {{ svc.upstream }} {
            {% if ph.standard | default(false) %}
            header_up Host      {host}
            header_up X-Real-IP {remote_host}
            {% endif %}
            header_down -Server
            header_down -X-Powered-By
        }
    }
    handle {
        {% if not _ui_managed and _profile.import_waf | default(false) %}
        import {{ 'waf_enforcement' if _waf_mode == 'enforcement' else 'waf' }}
        {% endif %}
        reverse_proxy {{ svc.upstream }} {
            {% if ph.standard | default(false) %}
            header_up Host      {host}
            header_up X-Real-IP {remote_host}
            {% endif %}
            header_down -Server
            header_down -X-Powered-By
        }
    }
    {% else %}
    {% if not _ui_managed and _profile.import_waf | default(false) %}
    import {{ 'waf_enforcement' if _waf_mode == 'enforcement' else 'waf' }}
    {% endif %}
    reverse_proxy {{ svc.upstream }} {
        {% if ph.standard | default(false) %}
        header_up Host      {host}
        header_up X-Real-IP {remote_host}
        {% endif %}
        header_down -Server
        header_down -X-Powered-By
    }
    {% endif %}

    {# Per-client cert path - client field is mandatory. #}
    # SC-8 / SC-13 | Cloudflare Origin Certificate (static, no ACME)
    tls /etc/caddy/certs/{{ svc.client }}/fullchain.pem /etc/caddy/certs/{{ svc.client }}/privkey.pem {
        protocols tls1.2 tls1.3
        {% if svc.tls_client_auth is defined and svc.tls_client_auth == 'cloudflare' %}
        client_auth {
            trusted_ca_cert_file /etc/caddy/certs/cloudflare-origin-pull-ca.pem
        }
        {% endif %}
    }

    # SC-7 / SC-23 | Per-service security headers
    header {
        Strict-Transport-Security   "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options      "nosniff"
        X-Frame-Options             "{{ svc.x_frame_options | default('DENY') }}"
        {% if svc.referrer_policy is defined and svc.referrer_policy | length > 0 %}
        Referrer-Policy             "{{ svc.referrer_policy }}"
        {% endif %}
        {% if svc.csp is defined and svc.csp | length > 0 %}
        Content-Security-Policy     "{{ svc.csp }}"
        {% endif %}
        {% if svc.permissions_policy is defined and svc.permissions_policy | length > 0 %}
        Permissions-Policy          "{{ svc.permissions_policy }}"
        {% endif %}
        -Server
    }
}
{% endif %}
{% endif %}
{% endfor %}
